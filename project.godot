; Ms. PAC-Man: Neo-Grid — demonstrador MV próprio, Godot 4.6.3
config_version=5

[application]
config/name="Ms. PAC-Man: Neo-Grid"
config/version="0.9.0-fusion"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
viewport/hdr_2d=false

[audio]
driver/enable_input=false

